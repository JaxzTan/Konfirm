# Template for next/.env. Copy to next/.env and fill in.
# NEXT_PUBLIC_* are inlined into the client bundle at build time and must also
# be listed in docker-compose.yml build.args + next/Dockerfile ARG/ENV.

# --- Sui chain ---------------------------------------------------------
NEXT_PUBLIC_SUI_NETWORK=
NEXT_PUBLIC_SUI_RPC=
NEXT_PUBLIC_PACKAGE_ID=0x...
NEXT_PUBLIC_REGISTRY_ID=0x...
SUI_ADDRESS=
SUI_ATTESTER_SECRET=suiprivkey1...

# --- Walrus storage ----------------------------------------------------
NEXT_PUBLIC_WALRUS_AGGREGATOR=
WALRUS_PUBLISHER=

# --- zkLogin / Enoki ---------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=
NEXT_PUBLIC_ENOKI_API_KEY=
ENOKI_SECRET_KEY=

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
DATABASE_URL=

# --- Peer identity -----------------------------------------------------
PUBLIC_BASE64KEY=
PEERID=

# --- AI / scanning providers -------------------------------------------
GONKA_ROUTER_API_KEY=
GEMINI_API_KEY=
CHATGPT_API_KEY=
VIRUSTOTAL_API_KEY=
