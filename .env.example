# Template for the repo-root .env — the only env file the stack reads.
# Copy to .env and fill in:  cp .env.example .env
#
# NEXT_PUBLIC_* are inlined into the client bundle at build time and must also
# be listed in docker-compose.yml build.args + next/Dockerfile ARG/ENV.

# --- Sui chain ---------------------------------------------------------
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_RPC=https://fullnode.testnet.sui.io:443
# The zkLogin wallet scripts/my-blobs.cjs watches by default. Not a key —
# a zkLogin address has no local keypair, so this is only a lookup handle.
SUI_WALLET=0x...
NEXT_PUBLIC_PACKAGE_ID=0x...

# --- Walrus storage ----------------------------------------------------
NEXT_PUBLIC_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# Server-only, for PUT /v1/blobs. Required — /api/health returns 503 without
# it, which fails the container healthcheck and stops nginx from starting.
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
WALRUS_EPOCHS=53

# --- zkLogin / Enoki ---------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ENOKI_API_KEY=
ENOKI_SECRET_KEY=

# --- Peer identity -----------------------------------------------------
PUBLIC_BASE64KEY=
PEERID=

# --- AI / scanning providers -------------------------------------------
GONKA_ROUTER_API_KEY=
GEMINI_API_KEY=
CHATGPT_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Tunnel (make tunnel only) -----------------------------------------
# NGROK is the account authtoken; NGROK_DOMAIN pins the reserved hostname so
# Google OAuth and Enoki keep matching their allowlisted origin.
NGROK=
NGROK_DOMAIN=
